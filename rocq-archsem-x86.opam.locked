opam-version: "2.0"
name: "rocq-archsem-x86"
version: "dev"
synopsis:
  "Rocq infrastructure to reason about hardware CPU architecture semantics, x86 instantiation"
maintainer: "Thibaut Pérami <thibaut.perami@cl.cam.ac.uk>"
authors: [
  "Thibaut Pérami"
  "Yeji Han"
  "Zonguyan Liu"
  "Nils Lauermann"
  "Jean Pichon-Pharabod"
  "Brian Campbell"
  "Alasdair Armstrong"
  "Ben Simner"
  "Peter Sewell"
]
license: "BSD-2-Clause"
homepage: "https://github.com/rems-project/archsem"
bug-reports: "https://github.com/rems-project/archsem/issues"
depends: [
  "astring" {= "0.8.5" & with-doc}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base" & dev}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2" & dev}
  "camlp-streams" {= "5.0.1" & with-doc}
  "cmdliner" {= "2.1.1" & with-doc}
  "conf-findutils" {= "1" & dev}
  "conf-gmp" {= "5"}
  "conf-linux-libc-dev" {= "0"}
  "conf-pkg-config" {= "5"}
  "coq" {= "9.1.0"}
  "rocq-archsem" {= "dev"}
  "rocq-archsem-common" {= "dev"}
  "coq-core" {= "9.1.0"}
  "coq-hammer-tactics" {= "1.3.3+9.1"}
  "coq-record-update" {= "0.3.6"}
  "coq-stdlib" {= "9.0.0"}
  "coqide-server" {= "9.1.0"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "dune" {= "3.23.1"}
  "dune-configurator" {= "3.23.1"}
  "dune-private-libs" {= "3.23.1" & dev}
  "dune-site" {= "3.23.1" & dev}
  "dyn" {= "3.23.1" & dev}
  "fmt" {= "0.11.0" & with-doc}
  "fpath" {= "0.7.3" & with-doc}
  "fs-io" {= "3.23.1" & dev}
  "lem" {= "2026-05-01" & dev}
  "libsail" {= "0.20.3" & dev}
  "linenoise" {= "1.5.1" & dev}
  "linksem" {= "0.8" & dev}
  "memprof-limits" {= "0.3.0"}
  "menhir" {= "20250912" & dev}
  "menhirCST" {= "20250912" & dev}
  "menhirLib" {= "20250912" & dev}
  "menhirSdk" {= "20250912" & dev}
  "num" {= "1.6" & dev}
  "ocaml" {= "5.4.1"}
  "ocaml-compiler" {= "5.4.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-option-flambda" {= "1"}
  "ocaml-option-fp" {= "1"}
  "ocaml-variants" {= "5.4.1+options"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1" & dev}
  "ocamlfind" {= "1.9.8"}
  "ocamlgraph" {= "2.2.0" & dev}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "omd" {= "1.3.2" & dev}
  "ordering" {= "3.23.1" & dev}
  "ott" {= "0.34" & dev}
  "pp" {= "2.0.0" & dev}
  "pprint" {= "20230830" & dev}
  "ppx_derivers" {= "1.2.1"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-doc}
  "rocq-core" {= "9.1.0"}
  "rocq-equations" {= "1.3.1+9.1"}
  "rocq-runtime" {= "9.1.0"}
  "rocq-sail-stdpp" {= "0.20.3"}
  "rocq-sail-tiny-x86" {= "dev" & dev}
  "rocq-stdlib" {= "9.0.0"}
  "rocq-stdpp" {= "1.13.0"}
  "rocq-stdpp-bitvector" {= "1.13.0"}
  "sail" {= "0.20.3" & dev}
  "sail_c_backend" {= "0.20.3" & dev}
  "sail_coq_backend" {= "0.20.3" & dev}
  "sail_doc_backend" {= "0.20.3" & dev}
  "sail_latex_backend" {= "0.20.3" & dev}
  "sail_lean_backend" {= "0.20.3" & dev}
  "sail_lem_backend" {= "0.20.3" & dev}
  "sail_maker" {= "0.20.3" & dev}
  "sail_ocaml_backend" {= "0.20.3" & dev}
  "sail_output" {= "0.20.3" & dev}
  "sail_smt_backend" {= "0.20.3" & dev}
  "sail_sv_backend" {= "0.20.3" & dev}
  "seq" {= "base" & with-doc}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "stdune" {= "3.23.1" & dev}
  "top-closure" {= "3.23.1" & dev}
  "topkg" {= "1.1.1" & with-doc}
  "tyxml" {= "4.6.0" & with-doc}
  "uutf" {= "1.0.4" & with-doc}
  "yojson" {= "3.0.0" & dev}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rems-project/archsem.git"
pin-depends: [
  ["libsail.0.20.3" "git+https://github.com/rems-project/sail.git#0f818e4"]
  [
  "rocq-sail-stdpp.0.20.3"
  "git+https://github.com/rems-project/coq-sail.git#e7b914c"
]
  [
  "rocq-sail-tiny-x86.dev"
  "git+https://github.com/rems-project/sail-tiny-x86.git#229bd84"
]
  ["sail.0.20.3" "git+https://github.com/rems-project/sail.git#0f818e4"]
