opam-version: "2.0"
name: "rocq-archsem"
version: "dev"
synopsis:
  "Rocq infrastructure to reason about hardware CPU architecture semantics, architecture generic part"
maintainer: "Thibaut Pérami <thibaut.perami@cl.cam.ac.uk>"
authors: [
  "Thibaut Pérami"
  "Yeji Han"
  "Zonguyan Liu"
  "Nils Lauermann"
  "Jean Pichon-Pharabod"
  "Brian Campbell"
  "Alasdair Armstrong"
  "Ben Simner"
  "Peter Sewell"
]
license: "BSD-2-Clause"
homepage: "https://github.com/rems-project/archsem"
bug-reports: "https://github.com/rems-project/archsem/issues"
depends: [
  "astring" {= "0.8.5" & with-doc}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-doc}
  "cmdliner" {= "2.1.1" & with-doc}
  "conf-gmp" {= "5"}
  "conf-linux-libc-dev" {= "0"}
  "conf-pkg-config" {= "5"}
  "coq" {= "9.1.0"}
  "rocq-archsem-common" {= "dev"}
  "coq-core" {= "9.1.0"}
  "coq-hammer-tactics" {= "1.3.3+9.1"}
  "coq-record-update" {= "0.3.6"}
  "coq-stdlib" {= "9.0.0"}
  "coqide-server" {= "9.1.0"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "dune" {= "3.23.1"}
  "dune-configurator" {= "3.23.1"}
  "fmt" {= "0.11.0" & with-doc}
  "fpath" {= "0.7.3" & with-doc}
  "memprof-limits" {= "0.3.0"}
  "ocaml" {= "5.4.1"}
  "ocaml-compiler" {= "5.4.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-option-flambda" {= "1"}
  "ocaml-option-fp" {= "1"}
  "ocaml-variants" {= "5.4.1+options"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1" & with-doc}
  "ocamlfind" {= "1.9.8"}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "ppx_derivers" {= "1.2.1"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-doc}
  "rocq-core" {= "9.1.0"}
  "rocq-equations" {= "1.3.1+9.1"}
  "rocq-runtime" {= "9.1.0"}
  "rocq-sail-stdpp" {= "0.20.3"}
  "rocq-stdlib" {= "9.0.0"}
  "rocq-stdpp" {= "1.13.0"}
  "rocq-stdpp-bitvector" {= "1.13.0"}
  "seq" {= "base" & with-doc}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "topkg" {= "1.1.1" & with-doc}
  "tyxml" {= "4.6.0" & with-doc}
  "uutf" {= "1.0.4" & with-doc}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rems-project/archsem.git"
pin-depends: [
  "rocq-sail-stdpp.0.20.3"
  "git+https://github.com/rems-project/coq-sail.git#e7b914c"
]