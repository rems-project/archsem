opam-version: "2.0"
name: "archsem"
version: "dev"
synopsis: "Archsem CLI and OCaml library to run ArchSem models"
maintainer: "Thibaut Pérami <thibaut.perami@cl.cam.ac.uk>"
authors: [
  "Thibaut Pérami"
  "Yeji Han"
  "Zonguyan Liu"
  "Nils Lauermann"
  "Jean Pichon-Pharabod"
  "Brian Campbell"
  "Alasdair Armstrong"
  "Ben Simner"
  "Peter Sewell"
]
license: "BSD-2-Clause"
homepage: "https://github.com/rems-project/archsem"
bug-reports: "https://github.com/rems-project/archsem/issues"
depends: [
  "astring" {= "0.8.5" & with-doc}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-doc}
  "camomile" {= "2.1.0" & with-dev-setup}
  "cmdliner" {= "2.1.1"}
  "conf-gmp" {= "5"}
  "conf-linux-libc-dev" {= "0"}
  "conf-pkg-config" {= "5"}
  "coq" {= "9.1.0"}
  "coq-archsem" {= "dev"}
  "coq-archsem-arm" {= "dev"}
  "coq-archsem-common" {= "dev"}
  "coq-core" {= "9.1.0"}
  "coq-hammer-tactics" {= "1.3.3+9.1"}
  "coq-record-update" {= "0.3.6"}
  "coq-stdlib" {= "9.0.0"}
  "coqide-server" {= "9.1.0"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "dune" {= "3.23.1"}
  "dune-build-info" {= "3.23.1" & with-dev-setup}
  "dune-configurator" {= "3.23.1"}
  "dune-private-libs" {= "3.23.1" & with-dev-setup}
  "dune-site" {= "3.23.1" & with-dev-setup}
  "dyn" {= "3.23.1" & with-dev-setup}
  "either" {= "1.0.0" & with-dev-setup}
  "fix" {= "20250919" & with-dev-setup}
  "fmt" {= "0.11.0" & with-doc}
  "fpath" {= "0.7.3" & with-doc}
  "fs-io" {= "3.23.1" & with-dev-setup}
  "headache" {= "1.08" & with-dev-setup}
  "memprof-limits" {= "0.3.0"}
  "menhir" {= "20250912"}
  "menhirCST" {= "20250912"}
  "menhirLib" {= "20250912"}
  "menhirSdk" {= "20250912"}
  "ocaml" {= "5.4.1"}
  "ocaml-compiler" {= "5.4.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-option-flambda" {= "1"}
  "ocaml-option-fp" {= "1"}
  "ocaml-variants" {= "5.4.1+options"}
  "ocaml-version" {= "4.1.4" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocamlformat-lib" {= "0.29.0" & with-dev-setup}
  "ocp-indent" {= "1.10.0" & with-dev-setup}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "ordering" {= "3.23.1" & with-dev-setup}
  "otoml" {= "1.0.5"}
  "ounit2" {= "2.2.7" & with-test}
  "pp" {= "2.0.0" & with-dev-setup}
  "ppx_derivers" {= "1.2.1"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-doc}
  "rocq-core" {= "9.1.0"}
  "rocq-equations" {= "1.3.1+9.1"}
  "rocq-runtime" {= "9.1.0"}
  "rocq-sail-stdpp" {= "0.20.3"}
  "rocq-stdlib" {= "9.0.0"}
  "rocq-stdpp" {= "1.13.0"}
  "rocq-stdpp-bitvector" {= "1.13.0"}
  "seq" {= "base" & with-test}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "stdune" {= "3.23.1" & with-dev-setup}
  "top-closure" {= "3.23.1" & with-dev-setup}
  "topkg" {= "1.1.1"}
  "tyxml" {= "4.6.0" & with-doc}
  "uucp" {= "18.0.0" & with-dev-setup}
  "uuseg" {= "18.0.0" & with-dev-setup}
  "uutf" {= "1.0.4"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rems-project/archsem.git"
pin-depends: [
  "rocq-sail-stdpp.0.20.3"
  "git+https://github.com/rems-project/coq-sail.git#e7b914c"
]